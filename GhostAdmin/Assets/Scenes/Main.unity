--- !u!114 &452914945
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 452914944}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c9b2dc9ce659f6644855796b9f97e31b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BriefingUI
  panel: {fileID: 2137956460}
  roleTitle: {fileID: 2084613716}
  tips: {fileID: 1666304776}
  countdown: {fileID: 31229222}
  titreInformaticien: INFORMATICIEN
  texteInformaticien: "Bonjour ing\xE9nieur informaticien !\nVotre travail commencera
    dans quelques instants, en attendant voici quelques explications :\n \nNotre
    \xE9cole a \xE9t\xE9 sabot\xE9e par un myst\xE9rieux individu. Vous avez donc
    \xE9t\xE9 embauch\xE9 pour tout remettre en ordre. Attention, le syst\xE8me n'a
    plus que quelques minutes avant d'\xEAtre d\xE9finitivement hors-service, vous
    n'aurez pas beaucoup de temps pour tout restaurer !\n \n \nLes pannes \xE0 r\xE9parer
    sont dispers\xE9es dans les diff\xE9rentes pi\xE8ces du b\xE2timents, nous avons
    appel\xE9 3 informaticiens. Malheureusement, le pirate s'est cach\xE9 dans votre
    \xE9quipe, nous craignons qu'il ne se contente pas de rester passif et sabote
    de nouveau les postes\u2026\n \n \nVotre mission, si vous l'acceptez, sera de
    r\xE9parer notre r\xE9seau et si vous le pouvez, d\xE9masquer cet imposteur afin
    qu'il ne fasse plus jamais de d\xE9g\xE2ts. Si vous \xEAtes s\xFBr de votre choix,
    r\xE9unissez vous \xE0 [endroit du vote] et voter pour la personne que vous suspectez,
    attention \xE0 ne pas vous tromper et \xE0 \xE9liminer un coll\xE8gue par erreur.\n
    \n \nLes commandes pour vous d\xE9placer sont les suivantes : \u2B05 A, \u2B06
    W, \u2B07 S, \u27A1 D, sinon les fl\xE8ches en bas \xE0 droite de votre clavier
    feront aussi l'affaire.\nPour interagir avec un objet, pressez E"
  titrePirate: PIRATE
  textePirate: "Bonjour pirate !\n \nTout ce qui est dis ici est strictement confidentiel,
    PERSONNE NE DOIT LE VOIR OU L'ENTENDRE.\n \nVotre travail a d\xE9j\xE0 commenc\xE9,
    vous vous \xEAtes infiltr\xE9 dans l'\xE9cole et l'avez sabot\xE9e. F\xE9licitation,
    leur r\xE9seau n'en a plus pour longtemps avant de l\xE2cher !\n \nMalheureusement,
    ils ont \xE9t\xE9 assez rapide pour appeler des ing\xE9nieurs informaticiens
    \xE0 la rescousse avant que leur syst\xE8me ne soit d\xE9finitivement hors-service.
    Il vous faut donc finir le travail, m\xEAlez vous \xE0 leur rang et sabotez leurs
    efforts dans l'ombre afin de gagner la partie. Une derni\xE8re chose, un syst\xE8me
    de vote \xE0 r\xE9cemment \xE9t\xE9 mis en place pour \xE9lire le coordinateur
    de la section, il est donc tr\xE8s probable qu'il soit utilis\xE9 pour essayer
    de vous d\xE9masquer alors restez discret.\n \nLes commandes pour vous d\xE9placer
    sont les suivantes : \u2B05 A, \u2B06 W, \u2B07 S, \u27A1 D, sinon les fl\xE8ches
    en bas \xE0 droite de votre clavier feront aussi l'affaire.\nPour interagir avec
    un objet, pressez E"
  ajusterMiseEnPage: 1
  margesLargeur: {x: 0.08, y: 0.08}
  bandeTitre: {x: 0.76, y: 0.94}
  bandeTexte: {x: 0.24, y: 0.72}
  bandeCompte: {x: 0.05, y: 0.2}
  tailleTitre: 72
  tailleMax: 36
